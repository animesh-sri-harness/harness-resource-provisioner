# Local Terraform working directories
.terraform/

# State files (use remote backend in production)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files — may contain secrets; never commit
*.tfvars
*.tfvars.json

# Local backend configuration (copy from backend.hcl.example)
backend.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan artifacts
*.tfplan
tfplan
plan.out

# Lock info from interrupted applies
.terraform.tfstate.lock.info

# CLI configuration
.terraformrc
terraform.rc

# OS/editor
.DS_Store
.idea/
.vscode/
